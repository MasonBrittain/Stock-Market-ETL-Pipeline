# ── Tickers ──────────────────────────────────────────────────────────────────
# Comma-separated Yahoo Finance ticker symbols
TICKERS=AAPL,MSFT,NVDA,GOOGL,AMZN

# ── Data Window ───────────────────────────────────────────────────────────────
# Data interval: 1d (daily), 1h (hourly), etc.
INTERVAL=1d

# Calendar days to look back for tickers that have no stored data yet.
# On subsequent runs, the pipeline downloads only from the last stored date.
LOOKBACK_DAYS=730

# ── Database ──────────────────────────────────────────────────────────────────
# SQLAlchemy connection URL. Defaults to a local SQLite file.
# For PostgreSQL: postgresql+psycopg2://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///data/stock_market.db

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=logs
REPORTS_DIR=reports

# ── Bronze Layer ──────────────────────────────────────────────────────────────
# "local" (default) writes Parquet under data/bronze/.
# "azure" writes to the Blob Storage container below — requires either
# AZURE_STORAGE_CONNECTION_STRING or AZURE_STORAGE_ACCOUNT_URL to be set.
BRONZE_TARGET=local
BRONZE_LOCAL_DIR=data/bronze
AZURE_STORAGE_CONTAINER=bronze
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_STORAGE_ACCOUNT_URL=https://<account>.blob.core.windows.net

# ── Streaming (V4) ────────────────────────────────────────────────────────────
# Replay rate for the streaming producer, in ticks per second.
REPLAY_SPEED=10
# 1-minute bar close vs 5-min average move (%) that triggers an alert row.
ALERT_THRESHOLD_PCT=2.0
# Warehouse the Spark processor writes bars to. Path is inside the container;
# the default maps to ./data/stock_market.db on the host via the compose mount.
STREAM_DATABASE_URL=sqlite:////data/stock_market.db
# Cloud opt-in (~$11/mo while provisioned — see scripts/provision_azure.ps1):
# STREAM_BROKER=eventhubs
# KAFKA_SASL_CONNECTION_STRING=
